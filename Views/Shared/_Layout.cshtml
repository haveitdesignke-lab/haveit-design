<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
	<title>Haveit Design — Stand Out To Impress</title>
	<meta name="description" content="We turn clicks into customers. Paid ads that print, brands that sell, websites that convert. Based in Nanyuki, serving Kenya.">
	<meta name="theme-color" content="#0A0A0A">
	<link rel="icon" href="/logo.jpg">
	<meta property="og:type" content="website">
	<meta property="og:title" content="Haveit Design — Stand Out To Impress">
	<meta property="og:description" content="We turn clicks into customers. Paid ads that print, brands that sell, websites that convert.">
	<meta property="og:image" content="/logo.jpg">
	<meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="630">
	<meta property="og:image:alt" content="Haveit Design logo">
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:image" content="/logo.jpg">
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&display=swap" rel="stylesheet">
	<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box
			}

			html {
				scroll-behavior: smooth
			}

			body {
				font-family: 'Inter',sans-serif;
				background: #0A0A0A;
				color: #fff;
				overflow-x: hidden;
				cursor: none
			}

			a, button {
				cursor: none
			}

			#progress {
				position: fixed;
				top: 0;
				left: 0;
				height: 2px;
				background: #FF9A3C;
				width: 0%;
				z-index: 9999;
				transition: width.1s
			}

			.cursor-dot {
				position: fixed;
				top: 0;
				left: 0;
				width: 6px;
				height: 6px;
				background: #FF9A3C;
				border-radius: 50%;
				pointer-events: none;
				z-index: 99999;
				transform: translate(-50%,-50%)
			}

			.cursor-ring {
				position: fixed;
				top: 0;
				left: 0;
				width: 32px;
				height: 32px;
				border: 1px solid rgba(255,154,60,.4);
				border-radius: 50%;
				pointer-events: none;
				z-index: 99999;
				transform: translate(-50%,-50%);
				transition: width.2s,height.2s,background.2s
			}

			body.hover.cursor-ring {
				width: 56px;
				height: 56px;
				background: rgba(255,154,60,.12);
				border-color: #FF9A3C
			}

			nav {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 16px 4%;
				background: rgba(10,10,10,.85);
				backdrop-filter: blur(20px);
				border-bottom: 1px solid #141414;
				position: sticky;
				top: 0;
				z-index: 100;
				transition: transform.4s
			}

				nav.hide {
					transform: translateY(-100%)
				}

			.nav-links {
				display: flex;
				align-items: center;
				gap: 28px
			}

				.nav-links a {
					color: #E8E8EA;
					text-decoration: none;
					font-size: 13px;
					letter-spacing: .02em;
					opacity: .65;
					font-weight: 500;
					transition: .2s
				}

					.nav-links a:hover {
						opacity: 1;
						color: #FF9A3C
					}

			.btn-nav {
				background: #FF9A3C;
				color: #111;
				padding: 11px 22px;
				border-radius: 100px;
				font-weight: 800;
				font-size: 12px;
				text-decoration: none;
				transition: .25s
			}

				.btn-nav:active, .btn-nav:focus, .btn-nav:hover {
					background: #FF9A3C !important;
					color: #111 !important;
					-webkit-text-fill-color: #111 !important;
					opacity: 1 !important
				}

			.hamburger {
				display: none;
				background: #1A1A1A;
				border: 1px solid #222;
				width: 42px;
				height: 42px;
				border-radius: 12px;
				color: #fff;
				font-size: 20px;
				cursor: pointer
			}

			.mobile-menu {
				display: none;
				position: fixed;
				inset: 70px 0 0 0;
				background: #0A0A0A;
				z-index: 99;
				padding: 24px 4%;
				flex-direction: column;
				gap: 0
			}

				.mobile-menu.open {
					display: flex
				}

				.mobile-menu a {
					color: #fff;
					text-decoration: none;
					font-size: 20px;
					font-weight: 800;
					border-bottom: 1px solid #151515;
					padding: 18px 0
				}

					.mobile-menu a.cta-mobile {
						margin-top: 18px;
						background: #FF9A3C;
						color: #111;
						border-radius: 100px;
						text-align: center;
						padding: 14px;
						border: none
					}

			.whatsapp {
				position: fixed;
				bottom: 88px;
				right: 22px;
				z-index: 999;
				width: 60px;
				height: 60px;
				border-radius: 50%;
				box-shadow: 0 12px 30px rgba(0,0,0,.6);
				transition: .2s
			}

				.whatsapp:hover {
					transform: scale(1.08)
				}

				.whatsapp img {
					width: 100%;
					height: 100%;
					border-radius: 50%
				}

			footer {
				border-top: 1px solid #141414;
				padding: 22px 4%;
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				align-items: center;
				background: #080808;
				gap: 14px
			}

				footer p {
					color: #3A3A3A;
					font-size: 11px
				}

			.footer-icon {
				width: 14px;
				height: 14px;
				object-fit: contain;
				filter: invert(1) brightness(0.8)
			}

			.footer-left {
				display: flex;
				justify-content: flex-start
			}

			.footer-center {
				display: flex;
				justify-content: center
			}

			.footer-right {
				display: flex;
				justify-content: flex-end;
				align-items: center;
				gap: 18px;
				flex-wrap: wrap
			}

			.socials {
				display: flex;
				gap: 10px
			}

				.socials a {
					width: 36px;
					height: 36px;
					border-radius: 10px;
					background: #131313;
					border: 1px solid #1E1E1E;
					display: grid;
					place-items: center;
					color: #7A7A7A;
					text-decoration: none;
					transition: .2s
				}

					.socials a:hover {
						color: #fff;
						border-color: #FF9A3C;
						background: #1A1A1A;
						transform: translateY(-2px)
					}

			.reveal {
				opacity: 0;
				transform: translateY(16px);
				transition: .6s cubic-bezier(.16,1,.3,1)
			}

				.reveal.in {
					opacity: 1;
					transform: none
				}

			@@media(max-width:900px) {
				.nav-links {
					display: none
				}

				.hamburger {
					display: grid;
					place-items: center
				}

				body {
					cursor: auto
				}

				a, button {
					cursor: pointer
				}

				.cursor-dot, .cursor-ring {
					display: none
				}

				footer {
					grid-template-columns: 1fr;
					text-align: center
				}

				.footer-center {
					order: 1
				}

				.footer-right {
					order: 2;
					justify-content: center
				}

				.footer-left {
					order: 3;
					justify-content: center;
					text-align: center
				}

				.whatsapp {
					bottom: 22px;
					width: 54px;
					height: 54px
				}
			}

			@@media(max-width:600px) {
				footer {
					padding: 20px 5% !important
				}

				.footer-right p {
					line-height: 1.9 !important;
					justify-content: center !important
				}

				.footer-center {
					margin-bottom: 6px
				}
			}
	</style>
</head>
<body>
	<div id="progress"></div>
	<div class="cursor-dot" id="dot"></div>
	<div class="cursor-ring" id="ring"></div>
	<nav id="navbar">
		<a href="#home" style="display:flex;align-items:center;gap:10px;text-decoration:none">
			<img src="~/images/haveit-logo.png" alt="haveit design" style="height:38px" loading="lazy" decoding="async" />
			<span style="color:#fff;font-size:18px;font-weight:800;letter-spacing:-.02em;line-height:.9">haveit<br /><span style="font-weight:400;opacity:.7">design</span></span>
		</a>
		<div class="nav-links">
			<a href="#home">Home</a>
			<a href="#Services">Services</a>
			<a href="#packages">Pricing</a>
			<a href="#contact-final">Contacts</a>
			<a href="#contact-final" class="btn-nav magnet">Get Started</a>
		</div>
		<button class="hamburger" id="hamb" onclick="toggleMenu()">☰</button>
	</nav>
	<div class="mobile-menu" id="mobMenu">
		<a href="#home" onclick="toggleMenu()">Home</a>
		<a href="#Services" onclick="toggleMenu()">Services</a>
		<a href="#packages" onclick="toggleMenu()">Pricing</a>
		<a href="#contact-final" onclick="toggleMenu()">Contacts</a>
		<a href="#contact-final" class="cta-mobile" onclick="toggleMenu()">Get Started</a>
	</div>
	@RenderBody()
	<a href="https://wa.me/254706489989" class="whatsapp magnet" target="_blank"><img src="~/images/whatsapp-icon.png" alt="WhatsApp" loading="lazy" decoding="async" /></a>
	<footer class="reveal">
		<p class="footer-left">© 2026 haveit design. All rights reserved.</p>
		<div class="footer-center">
			<div class="socials">
				<a href="https://www.instagram.com/haveit.design/" target="_blank" aria-label="Instagram"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none" /></svg></a>
				<a href="https://www.facebook.com/haveitdesign/" target="_blank" aria-label="Facebook"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M14 8h3V4h-3c-2.76 0-5 2.24-5 5v3H6v4h3v4h4v-4h3l1-4h-4V9c0-.55.45-1 1-1z" /></svg></a>
				<a href="https://www.linkedin.com/company/haveit-design" target="_blank" aria-label="LinkedIn"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5zM3 9h4v12H3V9zm7 0h3.83v1.64h.05c.53-1 1.84-2.05 3.79-2.05 4.05 0 4.8 2.67 4.8 6.14V21h-4v-6.1c0-1.45-.03-3.32-2.02-3.32-2.03 0-2.33 1.58-2.33 3.21V21H10V9z" /></svg></a>
			</div>
		</div>
		<div class="footer-right">
			<p style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:0">
				<span style="display:inline-flex;align-items:center;gap:6px"><img src="~/icons/telephone.png" alt="" class="footer-icon" loading="lazy" decoding="async"> +254 785 859 927</span>
				<span>•</span>
				<span style="display:inline-flex;align-items:center;gap:6px"><img src="~/icons/email.png" alt="" class="footer-icon" loading="lazy" decoding="async"> haveitdesign.ke@gmail.com</span>
				<span style="display:inline-flex;align-items:center;gap:12px;white-space:nowrap"><a href="/Home/Privacy" style="color:#555;font-size:11px;text-decoration:none">Privacy</a> <span>•</span> <a href="/Home/Terms" style="color:#555;font-size:11px;text-decoration:none">Terms</a></span>
			</p>
		</div>
	</footer>
	<script>
			function toggleMenu() { document.getElementById('mobMenu').classList.toggle('open'); }
			const dot = document.getElementById('dot'), ring = document.getElementById('ring'), prog = document.getElementById('progress'); let mx = 0, my = 0, rx = 0, ry = 0;
			document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; dot.style.left = mx + 'px'; dot.style.top = my + 'px'; });
			(function loop() { rx += (mx - rx) * .12; ry += (my - ry) * .12; ring.style.left = rx + 'px'; ring.style.top = ry + 'px'; requestAnimationFrame(loop); })();
			document.querySelectorAll('a,.magnet,.card,.btn-o,.btn-g,.fcard').forEach(el => { el.addEventListener('mouseenter', () => document.body.classList.add('hover')); el.addEventListener('mouseleave', () => document.body.classList.remove('hover')); });
			window.addEventListener('scroll', () => { let h = document.documentElement.scrollHeight - window.innerHeight; prog.style.width = (window.scrollY / h * 100) + '%'; });
			let lastY = 0; const nav = document.getElementById('navbar'); window.addEventListener('scroll', () => { if (window.scrollY > lastY && window.scrollY > 120) nav.classList.add('hide'); else nav.classList.remove('hide'); lastY = window.scrollY; });
			document.querySelectorAll('.magnet').forEach(btn => { btn.addEventListener('mousemove', e => { let r = btn.getBoundingClientRect(), x = e.clientX - r.left - r.width / 2, y = e.clientY - r.top - r.height / 2; if (window.innerWidth > 900) btn.style.transform = `translate(${x * .25}px,${y * .35}px)`; }); btn.addEventListener('mouseleave', () => btn.style.transform = 'translate(0,0)'); });
			const ro = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); }); }, { threshold: 0.12 });
			document.addEventListener('DOMContentLoaded', () => { document.querySelectorAll('.card,.cta,.fcard,.addon-faq,.faq-item,.pkg-card,footer').forEach(el => { el.classList.add('reveal'); ro.observe(el); }); });
	</script>
</body>
</html>