	</div>
</div>

<script>
	const words = ["Conversions and ROI", "Customers Not Clicks", "Revenue Not Likes", "Value Not Vanity"];
	let wi = 0, ci = 0, del = false;
	const el = document.getElementById('typeTarget');
	(function loop() {
		let w = words[wi];
		if (!del) {
			el.textContent = w.substring(0, ++ci);
			el.classList.remove('no-cursor');
			el.classList.add('typing');
			if (ci === w.length) { del = true; setTimeout(loop, 1600); return; }
		} else {
			el.textContent = w.substring(0, --ci);
			if (ci === 0) {
				el.classList.add('no-cursor');
				el.classList.remove('typing');
				del = false;
				wi = (wi + 1) % words.length;
			}
		}
		setTimeout(loop, del ? 35 : 90);
	})();
	function bookAudit() {
		const nameEl = document.getElementById('cName'), phoneEl = document.getElementById('cPhone'), nameErr = document.getElementById('nameErr'), phoneErr = document.getElementById('phoneErr');
		let name = nameEl.value.trim(), phone = phoneEl.value.trim(), valid = true;
		nameEl.classList.remove('input-error', 'shake'); phoneEl.classList.remove('input-error', 'shake'); nameErr.classList.remove('show'); phoneErr.classList.remove('show');
		void nameEl.offsetWidth; void phoneEl.offsetWidth;
		if (name.length < 2) { nameEl.classList.add('input-error', 'shake'); nameErr.classList.add('show'); valid = false; }
		let digits = phone.replace(/\D/g, ''); if (digits.length < 8) { phoneEl.classList.add('input-error', 'shake'); phoneErr.classList.add('show'); valid = false; }
		if (!valid) { if (name.length < 2) nameEl.focus(); else phoneEl.focus(); return; }
		const msg = `Hi Haveit Design, I am ${name} (${phone}). Book my growth audit - I want to turn clicks into customers.`;
		window.open('https://wa.me/254706489989?text=' + encodeURIComponent(msg), '_blank');
	}
	let usdKes = 129;
	async function fetchRate() { try { const r = await fetch('https://open.er-api.com/v6/latest/USD'); const d = await r.json(); if (d && d.rates && d.rates.KES) { usdKes = Math.round(d.rates.KES); document.getElementById('liveRate').textContent = `Live Rate: $1 = KES ${usdKes} • Auto-Updating`; const lr2 = document.getElementById('liveRate2'); if (lr2) lr2.textContent = usdKes; updatePrices(); } } catch (e) { } }
	function updatePrices() {
		document.querySelectorAll('.logo-card[data-usd]').forEach(card => { let usd = parseFloat(card.getAttribute('data-usd')); let kes = Math.round(usd * usdKes); const el = card.querySelector('.kes'); if (el) el.textContent = `KSh ${kes.toLocaleString()}`; });
		document.querySelectorAll('.pkg-card[data-usd]').forEach(card => { let usd = parseFloat(card.getAttribute('data-usd')); let kes = Math.round(usd * usdKes); const kesEl = card.querySelector('.kes'); const usdEl = card.querySelector('.usd'); if (kesEl && usdEl) { if (usdEl.textContent.includes('From')) kesEl.textContent = `KSh ${kes.toLocaleString()}`; else kesEl.textContent = `KSh ${kes.toLocaleString()}`; } });
		document.querySelectorAll('.pkg-card[data-kes]').forEach(card => { let kes = parseFloat(card.getAttribute('data-kes')); let usd = (kes / usdKes).toFixed(0); const usdEl = card.querySelector('.usd'); const kesEl = card.querySelector('.kes'); if (usdEl && kesEl) { if (kesEl.textContent.includes('Months') || kesEl.textContent.includes('Annual')) { const base = kesEl.textContent.includes('3 Months') ? ' — 3 Months' : ' — Annually'; kesEl.textContent = `KSh ${kes.toLocaleString()}${base}`; usdEl.textContent = `$${usd}`; } else { usdEl.textContent = `$${usd}`; } } });
	}
	function setCurr(c) { document.getElementById('btnUSD').classList.toggle('active', c === 'USD'); document.getElementById('btnKES').classList.toggle('active', c === 'KES'); }
	function orderLogo(type, usd) { let kes = Math.round(usd * usdKes); let msg = `Hi Haveit Design, I want ${type} Logo Design. Price $${usd} / KSh ${kes.toLocaleString()} (Rate $1 = KES ${usdKes}). Let's start.`; window.open('https://wa.me/254706489989?text=' + encodeURIComponent(msg), '_blank'); }
	function orderPkg(type, kes) { let usd = Math.round(kes / usdKes); let msg = `Hi Haveit Design, I want ${type}. Price KSh ${kes.toLocaleString()} / $${usd} (Rate $1 = KES ${usdKes}). Let's start.`; window.open('https://wa.me/254706489989?text=' + encodeURIComponent(msg), '_blank'); }
	function orderPkgUSD(type, usd) { let kes = Math.round(usd * usdKes); let msg = `Hi Haveit Design, I want ${type}. Price $${usd} / KSh ${kes.toLocaleString()} (Rate $1 = KES ${usdKes}). Let's start.`; window.open('https://wa.me/254706489989?text=' + encodeURIComponent(msg), '_blank'); }
	fetchRate(); updatePrices();
	function toggleFaq(btn) {
		const item = btn.closest('.faq-item');
		const wasOpen = item.classList.contains('open');
		document.querySelectorAll('.faq-item').forEach(i => { i.classList.remove('open'); i.querySelector('.faq-a').style.maxHeight = null; });
		if (!wasOpen) { item.classList.add('open'); item.querySelector('.faq-a').style.maxHeight = item.querySelector('.faq-a-inner').scrollHeight + 40 + 'px'; }
	}
	document.addEventListener('DOMContentLoaded', () => {
		const first = document.querySelector('.faq-item.open .faq-a');
		if (first) { first.style.maxHeight = first.querySelector('.faq-a-inner').scrollHeight + 40 + 'px'; }
	});
</script>