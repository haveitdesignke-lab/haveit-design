	<div class="addon-step"><b>02 — build</b><h4>fix fast</h4><p>Website, ads, brand — human-first, performance-driven, shipped in days.</p></div>
	<div class="addon-step"><b>03 — scale</b><h4>grow revenue</h4><p>We turn clicks into customers — track ROAS, not vanity metrics.</p></div>
</section>

<script>
	const words = ["conversions and ROI", "customers not clicks", "revenue not likes", "value not vanity"];
	let wi = 0, ci = 0, del = false; const el = document.getElementById('typeTarget');
	(function loop() { let w = words[wi]; if (!del) { el.textContent = w.substring(0, ++ci); if (ci === w.length) { del = true; setTimeout(loop, 1600); return; } } else { el.textContent = w.substring(0, --ci); if (ci === 0) { del = false; wi = (wi + 1) % words.length; } } setTimeout(loop, del ? 35 : 90); })();
	function bookAudit() {
		const nameEl = document.getElementById('cName'); const phoneEl = document.getElementById('cPhone');
		const nameErr = document.getElementById('nameErr'); const phoneErr = document.getElementById('phoneErr');
		let name = nameEl.value.trim(); let phone = phoneEl.value.trim(); let valid = true;
		nameEl.classList.remove('input-error', 'shake'); phoneEl.classList.remove('input-error', 'shake');
		nameErr.classList.remove('show'); phoneErr.classList.remove('show'); void nameEl.offsetWidth; void phoneEl.offsetWidth;
		if (name.length < 2) { nameEl.classList.add('input-error', 'shake'); nameErr.classList.add('show'); valid = false; }
		let digits = phone.replace(/\D/g, ''); if (digits.length < 8) { phoneEl.classList.add('input-error', 'shake'); phoneErr.classList.add('show'); valid = false; }
		if (!valid) { if (name.length < 2) nameEl.focus(); else phoneEl.focus(); return; }
		const msg = `Hi haveit design, I am ${name} (${phone}). Book my growth audit - I want to turn clicks into customers.`;
		window.open('https://wa.me/254706489989?text=' + encodeURIComponent(msg), '_blank');
	}
</script>