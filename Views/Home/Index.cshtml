@{
	ViewData["Title"] = "haveit design";
}
<link rel="stylesheet" href="~/css/haveit.css" asp-append-version="true" />

<style>
	.haveit-marquee-wrapper {
		width: 100%;
		overflow: hidden;
		background: #0C0C0C;
		border-top: 1px solid #141414;
		border-bottom: 1px solid #141414;
		padding: 28px 0;
		display: block;
		min-height: 80px;
	}

	.haveit-marquee-label {
		text-align: center;
		color: #4A4A4A;
		font-size: 10px;
		letter-spacing: .22em;
		text-transform: uppercase;
		font-weight: 700;
		margin-bottom: 18px;
	}

	.haveit-marquee-track {
		display: flex;
		align-items: center;
		gap: 64px;
		width: max-content;
		animation: haveit-scroll 80s linear infinite;
	}

	.haveit-logo-item {
		flex: 0 0 auto;
		filter: grayscale(100%) brightness(1.4);
		opacity: .7;
		transition: .3s;
	}

		.haveit-logo-item:hover {
			filter: grayscale(0%) brightness(1);
			opacity: 1;
			transform: scale(1.1)
		}

		.haveit-logo-item span {
			font-family: 'Inter',sans-serif;
			font-weight: 800;
			font-size: 13px;
			color: #E8E8EA;
			text-transform: uppercase;
			white-space: nowrap;
			letter-spacing: -.02em;
		}

	@@keyframes haveit-scroll {
		0% {
			transform: translateX(0)
		}

		100% {
			transform: translateX(-50%)
		}
	}
</style>

<section class="hero" id="home">
	<div class="hero-bg"></div>
	<div class="hero-left">
		<h1><span>where brands find</span><span class="dynamic" id="typeTarget">conversions and ROI</span></h1>
		<p>we turn clicks into customers — performance-driven marketing that builds trust, drives revenue, and scales your brand with human-first strategy.</p>
		<div class="btns"><a href="#contact" class="btn-o magnet">start your growth audit →</a></div>
		<div class="stats">
			<div class="stat"><b>312%</b><span style="color:#FF9A3C;font-weight:700;font-size:11px">ROAS</span><span>average return</span></div>
			<div class="stat"><b style="color:#fff">4.9/5<br />stars</b><span>from 200+ reviews</span></div>
			<div class="stat"><b>100+</b><span>brands scaled</span></div>
		</div>
	</div>
</section>

<section class="sec" id="work">
	<h2>what we do best — revenue, not vanity metrics</h2>
	<div class="cards">
		<div class="card magnet"><div class="ic">◎</div><h3>Digital Marketing & Stratetegy</h3><p>Turn online traffic into loyal customers.</p></div>
		<div class="card magnet"><div class="ic">✦</div><h3>Graphic & Logo Design</h3><p>Visual identities that leave a mark.</p></div>
		<div class="card magnet"><div class="ic">◫</div><h3>Visual UI & Web Design</h3><p>Digital storefronts that convert clicks into cash.</p></div>
		<div class="card magnet"><div class="ic">◍</div><h3>Social Media Marketing</h3><p>Turning passive followers into active buyers.</p></div>
		<div class="card magnet"><div class="ic">✉</div><h3>Email Marketing & Bulk SMS</h3><p>Bringing back 36% of lost sales.</p></div>
		<div class="card magnet"><div class="ic">↗</div><h3>Brand Solutions</h3><p>Giving your business a voice, and a pulse.</p></div>
	</div>
	<div class="cta" id="contact">
		<div><h2>ready to turn clicks<br />into customers?</h2><p>Growth audit in 24hrs. 3 leaks costing you money — no pitch.</p></div>
		<div class="form" style="flex-direction:column;align-items:flex-start">
			<div style="display:flex;gap:10px;flex-wrap:wrap">
				<div><input id="cName" placeholder="Your Name" /><div id="nameErr" class="error-msg">please enter your name</div></div>
				<div><input id="cPhone" placeholder="Your Number" inputmode="tel" /><div id="phoneErr" class="error-msg">please enter your number</div></div>
				<button class="btn-book magnet" onclick="bookAudit()">book my growth audit</button>
			</div>
		</div>
	</div>
</section>

